# How often to check for new books (e.g., 1h, 4h, 6h, 12h)
SLEEP_TIME=1h

# Path to Libation config directory (must contain AccountsSettings.json)
CONFIG_PATH=./config

# Path where audiobooks will be downloaded
BOOKS_PATH=/path/to/your/audiobooks

# --- Plex Integration (only needed for Option B: the sidecar) ---
# Most setups don't need these — see "Plex Integration" in the README.
# Leave them unset if you use Plex's built-in scanning (Option A).
# Your Plex server URL
PLEX_URL=http://localhost:32400
# Plex API token (find at: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
PLEX_TOKEN=your-plex-token
# Plex library section ID for audiobooks — frequently NOT 1.
# Find yours via: curl "$PLEX_URL/library/sections?X-Plex-Token=$PLEX_TOKEN"
PLEX_LIBRARY_ID=1
